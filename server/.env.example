# Minecraft Server Environment Variables
# Copy this file to .env and customize your private settings:
# cp .env.example .env

RCON_PASSWORD=change_me_rcon_password

# ModSync API & VPS Reverse Proxy
MODSYNC_DOMAIN=mods.example.com
MODSYNC_ADMIN_TOKEN=change_me_admin_token
# Optional shared token required from clients connecting to /ws (leave empty for open friend access)
MODSYNC_CLIENT_TOKEN=

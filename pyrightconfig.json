{
  "pythonVersion": "3.12",
  "pythonPlatform": "All",
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    "**/.*",
    "server/data",
    "client/build",
    "client/dist",
    "**/.venv"
  ],
  "executionEnvironments": [
    {
      "root": "modsync_api",
      "extraPaths": [
        "modsync_api",
        "modsync_api/.venv/lib/python3.12/site-packages"
      ]
    },
    {
      "root": "client",
      "extraPaths": [
        "client/src",
        "client/.venv/lib/python3.12/site-packages"
      ]
    },
    {
      "root": "client-e2e",
      "extraPaths": [
        "client-e2e",
        "client/src",
        "client/.venv/lib/python3.12/site-packages",
        "client-e2e/.venv/lib/python3.12/site-packages"
      ]
    },
    {
      "root": "ci",
      "extraPaths": [
        "."
      ]
    },
    {
      "root": "server/mods",
      "extraPaths": [
        "server/mods"
      ]
    }
  ]
}

# Root Minecraft runtime server data and worlds
/data/

# Mod binaries
*.jar

# Logs and archives
*.log
*.log.gz
*.tar.gz

# Environment overrides
.env
.env.*

# WireGuard private keys and client config
/wireguard/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Obsidian workspace layout and local cache
**/.obsidian/workspace*.json
**/.obsidian/plugins/*/binaries/
**/.obsidian-hybrid-search.db*
**/.obsidian/plugins/termy/agent-context/obsidian-context.json

# Server config safety guards (secrets, DBs, downloaded libs, caches, player state)
server-config/**/discord.json
server-config/**/storage.json
server-config/**/luckperms.conf
server-config/**/libs/
server-config/**/data/
server-config/**/cache/
server-config/**/tmp/
server-config/**/translations/
server-config/**/banned-ips.json
server-config/**/banned-players.json
server-config/**/usercache.json
server-config/**/usernamecache.json
server-config/**/whitelist.json
server-config/**/ops.json
*.db
*.db-wal
*.db-shm
*.db-journal
*.mv.db
*.trace.db
*.sqlite
*.sqlite3
*.gz
*.zip
*.tar
*.jfr


# Root Minecraft runtime server data and worlds
/data/

# Mod binaries
*.jar

# Logs and archives
*.log
*.log.gz
*.tar.gz

# Environment overrides
.env

# WireGuard private keys and client config
/wireguard/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Obsidian workspace layout and local cache
**/.obsidian/workspace*.json
**/.obsidian/plugins/*/binaries/
**/.obsidian-hybrid-search.db*
**/.obsidian/plugins/termy/agent-context/obsidian-context.json


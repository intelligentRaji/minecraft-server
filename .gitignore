# Root Minecraft runtime server data and worlds
/server/data/

# Mod binaries
*.jar

# Logs and archives
*.log
*.log.gz
*.tar.gz

# Environment overrides
.env
.env.*
!.env.example
!/server/.env.example

# WireGuard private keys and client config
/server/wireguard/

# Python bytecode, virtualenvs, test & build caches
__pycache__/
*.py[cod]
*$py.class
.venv/
.pytest_cache/
*.egg-info/
/client/build/
/client/dist/

# Obsidian workspace layout and local cache
**/.obsidian/workspace*.json
**/.obsidian/plugins/*/binaries/
**/.obsidian-hybrid-search.db*
**/.obsidian/plugins/termy/agent-context/obsidian-context.json

# Server config safety guards (secrets, DBs, downloaded libs, caches, player state)
server/mods/**/configs/**/discord.json
server/mods/**/configs/**/storage.json
server/mods/**/configs/**/libs/
server/mods/**/configs/**/data/
server/mods/**/configs/**/cache/
server/mods/**/configs/**/tmp/
server/mods/**/configs/**/translations/
server/mods/**/configs/**/banned-ips.json
server/mods/**/configs/**/banned-players.json
server/mods/**/configs/**/usercache.json
server/mods/**/configs/**/usernamecache.json
server/mods/**/configs/**/whitelist.json
server/mods/**/configs/**/ops.json
*.db
*.db-wal
*.db-shm
*.db-journal
*.mv.db
*.trace.db
*.sqlite
*.sqlite3
*.gz
*.zip
*.tar
*.jfr

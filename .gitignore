# Root Minecraft runtime server data and worlds
/data/

# Mod binaries
*.jar

# Logs and archives
*.log
*.log.gz
*.tar.gz

# Environment overrides
.env
.env.*

# WireGuard private keys and client config
/wireguard/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class

# Obsidian workspace layout and local cache
**/.obsidian/workspace*.json
**/.obsidian/plugins/*/binaries/
**/.obsidian-hybrid-search.db*
**/.obsidian/plugins/termy/agent-context/obsidian-context.json

# Server config safety guards (secrets, DBs, downloaded libs, caches, player state)
mods/**/configs/**/discord.json
mods/**/configs/**/storage.json
mods/**/configs/**/libs/
mods/**/configs/**/data/
mods/**/configs/**/cache/
mods/**/configs/**/tmp/
mods/**/configs/**/translations/
mods/**/configs/**/banned-ips.json
mods/**/configs/**/banned-players.json
mods/**/configs/**/usercache.json
mods/**/configs/**/usernamecache.json
mods/**/configs/**/whitelist.json
mods/**/configs/**/ops.json
*.db
*.db-wal
*.db-shm
*.db-journal
*.mv.db
*.trace.db
*.sqlite
*.sqlite3
*.gz
*.zip
*.tar
*.jfr


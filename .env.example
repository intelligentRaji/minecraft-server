# Minecraft Server Environment Variables
# Copy this file to .env and customize your private settings:
# cp .env.example .env

RCON_PASSWORD=change_me_rcon_password

# ModSync API
# Home WireGuard interface IP so VPS Caddy can reach modsync-api over wg0
MODSYNC_WG_IP=127.0.0.2
# Public URL players use to reach modsync-api (used by 'make invite-link' to generate modsync:// links)
MODSYNC_SERVER_URL=change_me_modsync_server_url
# Admin token required to access modsync-api admin endpoints
MODSYNC_ADMIN_TOKEN=change_me_admin_token
# Shared bearer/WS token required from clients connecting to modsync-api
MODSYNC_CLIENT_TOKEN=change_me_client_token
